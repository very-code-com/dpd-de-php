{
    "name": "very-code-com/dpd-de-php",
    "description": "PHP client for the DPD Cloud Service Webservice (setOrder, getParcelLifeCycle, getOrderStatus, getParcelShopFinder, getZipCodeRules). SOAP by default, optional REST transport.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["dpd", "dpd-cloud-service", "logistics", "shipping", "soap", "rest", "api", "client", "germany"],
    "homepage": "https://github.com/very-code-com/dpd-de-php",
    "authors": [
        {
            "name": "Very Code",
            "homepage": "https://very-code.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "VeryCodeCom\\DpdDe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeryCodeCom\\DpdDe\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
